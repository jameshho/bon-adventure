extends SceneTree
## Palette clustering report (P3-22, 25 Nov 2026; docs/guides/MODULAR_TOWN.md "Material palette").
## For each town scene (scenes/town/<unit>.scn, instanced without entering the tree: what is
## saved), every plain StandardMaterial3D / ORMMaterial3D colour on a mesh is weighted by the
## surface area it covers (the mesh's box, scaled), clustered in OKLab and compared with the
## game palette (scripts/core/game_palette.gd). Also lists the ground shader colours.
##   godot --headless --path . --script res://tools/palette_report.gd -- [unit ...] [--out <file.md>]
## No unit = every unit and the base. Reads only; writes the markdown file when --out is given.
## Bands (OKLab distance to the nearest palette colour): on <= ON, near <= NEAR, far beyond.
## "Step-owned" = a town material (palette file or stored in the scene) outside instanced prefabs
## and outside word roots other than "Building Parts": what palette_snap.gd may recolour.
const MaterialPalette = preload("res://tools/material_palette.gd")
const PaletteSnap = preload("res://scripts/buildings/palette_snap.gd")
const CLUSTER := 0.04
const ON := 0.03
const NEAR := PaletteSnap.LIMIT
const TOP := 14
const GROUND := ["grass", "paving", "road", "sand"]
var targets := []
var lines := []

func _initialize() -> void:
	targets = MaterialPalette.palette_targets()
	var args := OS.get_cmdline_user_args()
	var out := ""
	var units := []
	var i := 0
	while i < args.size():
		if args[i] == "--out" and i + 1 < args.size():
			out = args[i + 1]
			i += 1
		else:
			units.append(args[i])
		i += 1
	if units.is_empty():
		units = ["base"] + (JSON.parse_string(FileAccess.get_file_as_string("res://data/buildings.json")).units.keys())
	say("# Palette clustering report")
	say("")
	say("Generated by `tools/palette_report.gd` on %s. Area = surface area of the meshes' boxes (m², town scale), a rough stand-in for what the player sees. Bands: OKLab distance to the nearest `game_palette.gd` colour, on ≤ %.2f, near ≤ %.2f, far beyond; clusters merge colours within %.2f." % [Time.get_date_string_from_system(), ON, NEAR, CLUSTER])
	say("")
	say("| Unit | Area | Colours | Clusters | On | Near | Far | Step-owned | Prefab | Word props |")
	say("| --- | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: |")
	var details := []
	for unit in units:
		var data := survey(unit)
		if data.is_empty():
			continue
		var total: float = data.total
		var clusters := cluster(data.colours)
		say("| %s | %d | %d | %d | %s | %s | %s | %s | %s | %s |" % [unit, total, data.colours.size(), clusters.size(),
			pct(data.band.on, total), pct(data.band.near, total), pct(data.band.far, total),
			pct(data.kind.step, total), pct(data.kind.prefab, total), pct(data.kind.word, total)])
		details.append([unit, total, clusters])
	say("")
	say("## Ground shader colours")
	say("")
	say("| Material | Parameter | Colour | Nearest | Distance |")
	say("| --- | --- | --- | --- | ---: |")
	for ground in GROUND:
		var material := load("res://shaders/%s.tres" % ground) as ShaderMaterial
		for property in material.get_property_list():
			var value = material.get(property.name)
			if value is Color:
				var best := MaterialPalette.nearest(value, targets)
				say("| %s | %s | `%s` | %s `%s` | %.3f |" % [ground, property.name.trim_prefix("shader_parameter/"), value.to_html(false), best[0], best[1].to_html(false), best[2]])
	for detail in details:
		say("")
		say("## %s: top clusters by area" % detail[0])
		say("")
		say("| Colour | Area | Members | Nearest | Distance | Step-owned |")
		say("| --- | ---: | ---: | --- | ---: | ---: |")
		for c in (detail[2] as Array).slice(0, TOP):
			var best := MaterialPalette.nearest(c.colour, targets)
			say("| `%s` | %s | %d | %s `%s` | %.3f | %s |" % [c.colour.to_html(false), pct(c.area, detail[1]), c.members, best[0], best[1].to_html(false), best[2], pct(c.step, c.area)])
	if out != "":
		var file := FileAccess.open(out, FileAccess.WRITE)
		file.store_string("\n".join(lines) + "\n")
		print("PALETTE REPORT: wrote ", out)
	print("PALETTE REPORT: %d units" % details.size())
	quit(0)

func say(text: String) -> void:
	lines.append(text)
	print(text)

static func pct(part: float, whole: float) -> String:
	return "%d%%" % roundi(100.0 * part / maxf(whole, 0.001))

## {total, colours: {html: {colour, area, step}}, band: {on, near, far}, kind: {step, prefab, word}}
func survey(unit: String) -> Dictionary:
	var packed := load("res://scenes/town/%s.scn" % unit) as PackedScene
	if packed == null:
		printerr("PALETTE REPORT: no scene for ", unit)
		return {}
	var top := packed.instantiate()
	var data := {"total": 0.0, "colours": {}, "band": {"on": 0.0, "near": 0.0, "far": 0.0}, "kind": {"step": 0.0, "prefab": 0.0, "word": 0.0}}
	walk(top, Transform3D.IDENTITY, false, false, data)
	top.free()
	return data

func walk(node: Node, parent: Transform3D, in_word: bool, in_prefab: bool, data: Dictionary) -> void:
	var xform := parent
	if node is Node3D:
		xform = parent * (node as Node3D).transform
	in_word = in_word or node.has_meta("word_key") and not PaletteSnap.shell_word(str(node.get_meta("word_key")))
	in_prefab = in_prefab or (node.scene_file_path != "" and node.owner != null)
	if node is MeshInstance3D and (node as MeshInstance3D).mesh != null:
		var mi := node as MeshInstance3D
		var count := mi.mesh.get_surface_count()
		var area := box_area(mi.mesh.get_aabb(), xform.basis) / maxf(count, 1)
		for surface in count:
			var material: Material = mi.get_surface_override_material(surface)
			if material == null:
				material = mi.material_override
			if material == null:
				material = mi.mesh.surface_get_material(surface)
			add(material, area, in_word, in_prefab, data)
	elif node is MultiMeshInstance3D and (node as MultiMeshInstance3D).multimesh != null and (node as MultiMeshInstance3D).multimesh.mesh != null:
		var mm := (node as MultiMeshInstance3D).multimesh
		var material: Material = (node as MultiMeshInstance3D).material_override
		if material == null and mm.mesh.get_surface_count() > 0:
			material = mm.mesh.surface_get_material(0)
		add(material, box_area(mm.mesh.get_aabb(), xform.basis) * mm.instance_count, in_word, in_prefab, data)
	elif node is CSGBox3D:
		add((node as CSGBox3D).material, box_area(AABB(Vector3.ZERO, (node as CSGBox3D).size), xform.basis), in_word, in_prefab, data)
	for child in node.get_children():
		walk(child, xform, in_word, in_prefab, data)

static func box_area(box: AABB, basis: Basis) -> float:
	var s := box.size * basis.get_scale().abs()
	return 2.0 * (s.x * s.y + s.y * s.z + s.z * s.x)

## Plain colours only: opaque, no albedo texture, no emission.
static func plain(material: Material) -> bool:
	if not material is BaseMaterial3D:
		return false
	var m := material as BaseMaterial3D
	return m.albedo_texture == null and m.transparency == BaseMaterial3D.TRANSPARENCY_DISABLED and not m.emission_enabled

func add(material: Material, area: float, in_word: bool, in_prefab: bool, data: Dictionary) -> void:
	if not plain(material) or area <= 0.0:
		return
	var colour: Color = (material as BaseMaterial3D).albedo_color
	var path := material.resource_path
	var town := path == "" or path.begins_with(MaterialPalette.FOLDER) or path.begins_with("res://scenes/town/")
	var prefab := in_prefab or not town
	var step := not prefab and not in_word
	data.total += area
	var key := colour.to_html(false)
	if not data.colours.has(key):
		data.colours[key] = {"colour": colour, "area": 0.0, "step": 0.0}
	data.colours[key].area += area
	if step:
		data.colours[key].step += area
		data.kind.step += area
	elif prefab:
		data.kind.prefab += area
	else:
		data.kind.word += area
	var d: float = MaterialPalette.nearest(colour, targets)[2]
	data.band["on" if d <= ON else "near" if d <= NEAR else "far"] += area

## Greedy clustering by area: each colour joins the first bigger cluster within CLUSTER.
func cluster(colours: Dictionary) -> Array:
	var sorted := colours.values()
	sorted.sort_custom(func(a, b): return a.area > b.area)
	var result := []
	for entry in sorted:
		var lab := MaterialPalette.oklab(entry.colour)
		var home = null
		for c in result:
			if c.lab.distance_to(lab) <= CLUSTER:
				home = c
				break
		if home == null:
			result.append({"colour": entry.colour, "lab": lab, "area": entry.area, "step": entry.step, "members": 1})
		else:
			home.area += entry.area
			home.step += entry.step
			home.members += 1
	return result
